#!/usr/bin/env bash
set -uo pipefail

CMD="${1:-detect}"
TARGET="${2:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
TARGET="$(cd "$TARGET" 2>/dev/null && pwd)" || { printf 'arm: no such directory: %s\n' "${2:-}" >&2; exit 2; }
KIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"
PROBE_TIMEOUT="${ARM_TIMEOUT:-600}"
SEP=$'\x1f'
NL=$'\n'
MANIFESTS="package.json pyproject.toml requirements.txt setup.py go.mod Cargo.toml Makefile"

command -v python3 >/dev/null 2>&1 || { printf 'arm: CANNOT RUN, python3 is required\n' >&2; exit 2; }

say() { printf '%s\n' "$*" >&2; }

is_placeholder() {
  case "$(printf '%s' "$1" | sed 's/^[[:space:]]*//')" in
    echo*|true*|:*|"#"*) return 0 ;;
    *) return 1 ;;
  esac
}

shq() {
  case "$1" in
    ""|*[!A-Za-z0-9._/-]*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
    *) printf '%s' "$1" ;;
  esac
}

slug() { printf '%s' "$1" | sed 's/[^A-Za-z0-9._-]/-/g'; }

run_probe() {
  python3 - "$1" "$2" "$PROBE_TIMEOUT" <<'PY'
import os, signal, subprocess, sys

directory, command, limit = sys.argv[1], sys.argv[2], float(sys.argv[3])
proc = subprocess.Popen(["bash", "-c", command], cwd=directory, stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                        start_new_session=True)

def reap():
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass

def stop(sig, _frame):
    reap()
    sys.exit(128 + sig)

signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
try:
    rc = proc.wait(timeout=limit)
except subprocess.TimeoutExpired:
    reap()
    proc.wait()
    sys.exit(124)
reap()
sys.exit(128 - rc if rc < 0 else rc)
PY
}

guard() {
  python3 - "$@" <<'PY'
import json, os, subprocess, sys

mode, root, snap_file = sys.argv[1:4]
label = sys.argv[4] if len(sys.argv) > 4 else ""
MAX_NOTES = 8

top = subprocess.run(["git", "-C", root, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
if top.returncode != 0:
    sys.exit(0)
top = top.stdout.strip()
scope = os.path.relpath(os.path.realpath(root), os.path.realpath(top))

def status():
    p = subprocess.run(["git", "-C", top, "status", "--porcelain=v1", "-z", "-uall",
                        "--ignored=matching", "--", scope], capture_output=True)
    if p.returncode != 0:
        return None
    fields = p.stdout.decode("utf-8", "surrogateescape").split("\0")
    out, i = {}, 0
    while i < len(fields):
        entry = fields[i]
        i += 1
        if len(entry) < 4:
            continue
        xy, path = entry[:2], entry[3:]
        if "R" in xy or "C" in xy:
            i += 1
        out[path] = xy
    return out

def stamp(path):
    try:
        st = os.lstat(os.path.join(top, path))
    except OSError:
        return [None, None]
    return [st.st_size, st.st_mtime_ns]

def drop_empty_parents(path):
    parent = os.path.dirname(os.path.join(top, path))
    while parent != top and parent.startswith(top):
        try:
            os.rmdir(parent)
        except OSError:
            return
        parent = os.path.dirname(parent)

current = status()
if current is None:
    sys.exit(0)

if mode == "snap":
    with open(snap_file, "w", encoding="utf-8") as fh:
        json.dump({p: [xy] + stamp(p) for p, xy in current.items()}, fh)
    sys.exit(0)

with open(snap_file, encoding="utf-8") as fh:
    before = json.load(fh)
notes, left = [], []
for path, xy in sorted(current.items()):
    if path in before:
        if xy != "!!" and before[path][1:] != stamp(path):
            notes.append(f"changed {path} (it already held your changes; left as is)")
            before[path] = [xy] + stamp(path)
        continue
    if xy == "??":
        try:
            os.remove(os.path.join(top, path))
            drop_empty_parents(path)
            notes.append(f"created {path} (removed)")
        except OSError as exc:
            notes.append(f"created {path} (could not remove: {exc})")
    elif xy == "!!":
        left.append(path)
        before[path] = [xy] + stamp(path)
    elif xy in (" M", " D", " T"):
        done = subprocess.run(["git", "-C", top, "checkout", "--", path], capture_output=True)
        notes.append(f"modified {path} ({'restored' if done.returncode == 0 else 'could not restore'})")
    else:
        notes.append(f"changed {path} in the index (left as is)")
        before[path] = [xy] + stamp(path)
if left:
    shown = ", ".join(left[:3]) + (f" and {len(left) - 3} more" if len(left) > 3 else "")
    notes.append(f"left {len(left)} ignored path(s) in place: {shown}")
with open(snap_file, "w", encoding="utf-8") as fh:
    json.dump(before, fh)
for line in notes[:MAX_NOTES]:
    print(f"  note   {label}: {line}", file=sys.stderr)
if len(notes) > MAX_NOTES:
    print(f"  note   {label}: and {len(notes) - MAX_NOTES} more", file=sys.stderr)
PY
}

npm_script() {
  python3 - "$1/package.json" "$2" <<'PY' 2>/dev/null
import json, sys
try:
    s = json.load(open(sys.argv[1])).get("scripts") or {}
except Exception:
    raise SystemExit(0)
v = s.get(sys.argv[2])
if isinstance(v, str):
    print(v)
PY
}

make_recipe() {
  awk -v t="^$2:" '$0 ~ t {f=1; next} f && /^\t/ {sub(/^\t/,""); print; exit} f && /^[^\t]/ {exit}' \
    "$1/Makefile" 2>/dev/null
}

emit() { printf '%s\n' "$1$SEP$2$SEP$3$SEP${4:-$3}$SEP${5:-}$SEP${6:-$3}"; }

has_manifest() {
  local m
  for m in $MANIFESTS; do [ -f "$1/$m" ] && return 0; done
  return 1
}

skip_dir() {
  case "$1" in
    node_modules|vendor|dist|build|out|target|coverage|examples|example|fixtures|fixture|testdata|venv|site-packages|__pycache__) return 0 ;;
  esac
  return 1
}

usable_app_dir() {
  [ -d "$1" ] && [ ! -L "$1" ] && [ ! -e "$1/.git" ] && has_manifest "$1" \
    && ! printf '%s' "$1" | grep -q '[][*?{}]'
}

app_dirs() {
  local d="$1" a b
  shopt -s nullglob
  for a in "$d"/*/; do
    a="${a%/}"
    skip_dir "${a##*/}" && continue
    usable_app_dir "$a" && printf '%s\n' "${a#"$d"/}"
    for b in "$a"/*/; do
      b="${b%/}"
      skip_dir "${b##*/}" && continue
      usable_app_dir "$b" && printf '%s\n' "${b#"$d"/}"
    done
  done
  shopt -u nullglob
  return 0
}

candidates() {
  local d="$1" b r="" s
  if [ -f "$d/package.json" ]; then
    b="$(npm_script "$d" lint)";      [ -n "$b" ] && emit fast js-lint      'npm run lint'      "$b"
    b="$(npm_script "$d" typecheck)"; [ -n "$b" ] && emit fast js-typecheck 'npm run typecheck' "$b"
    b="$(npm_script "$d" test)";      [ -n "$b" ] && emit full js-test      'npm test --silent' "$b"
    [ -f "$d/tsconfig.json" ] && emit full js-tsc 'npx --no-install tsc --noEmit' 'tsc --noEmit'
  fi
  if [ -f "$d/pyproject.toml" ] || [ -f "$d/requirements.txt" ] || [ -f "$d/setup.py" ]; then
    command -v uv >/dev/null 2>&1 && r="uv run "
    emit fast py-lint      "${r}ruff check ."
    emit fast py-typecheck "${r}mypy ."
    emit full py-test      "${r}pytest -q"
  elif { compgen -G "$d/tests/*.py" || compgen -G "$d/test/*.py"; } >/dev/null && command -v pytest >/dev/null 2>&1; then
    emit full py-test-bare 'pytest -q'
  fi
  [ -f "$d/go.mod" ]     && { emit fast go-vet    'go vet ./...';                  emit full go-test 'go test ./...'; }
  [ -f "$d/Cargo.toml" ] && { emit fast rs-clippy 'cargo clippy -- -D warnings';   emit full rs-test 'cargo test'; }
  if [ -f "$d/Makefile" ]; then
    b="$(make_recipe "$d" lint)"; [ -n "$b" ] && emit fast make-lint 'make lint' "$b"
    b="$(make_recipe "$d" test)"; [ -n "$b" ] && emit full make-test 'make test' "$b"
  fi
  for s in selftest.sh test.sh run-tests.sh runtests.sh scripts/test.sh bin/test; do
    [ -x "$d/$s" ] && emit full "script-${s##*/}" "./$s"
  done
  return 0
}

policy_candidates() {
  local d="$1" kit_copy="$KIT_ROOT/benchmark/gates/trailer-check.py"
  [ -f "$d/.claude/forbidden-trailers" ] || return 0
  git -C "$d" rev-parse --verify --quiet HEAD >/dev/null 2>&1 || return 0
  if [ -f "$d/.claude/gates/trailer-check.py" ]; then
    emit policy co-author 'python3 .claude/gates/trailer-check.py'
  elif [ -f "$kit_copy" ]; then
    emit policy co-author 'python3 .claude/gates/trailer-check.py' 'python3 .claude/gates/trailer-check.py' '' "python3 $(shq "$kit_copy")"
  fi
  return 0
}

all_candidates() {
  local d="$1" sub tier name cmd body surf probe q
  candidates "$d"
  while IFS= read -r sub; do
    q="cd $(shq "$sub") && "
    while IFS="$SEP" read -r tier name cmd body surf probe; do
      [ -n "${tier:-}" ] || continue
      emit "$tier" "$(slug "$sub")-$name" "$q$cmd" "$body" "$sub/**" "$q$probe"
    done < <(candidates "$d/$sub")
  done < <(app_dirs "$d")
  policy_candidates "$d"
}

PASS_FAST=(); PASS_FULL=(); N_CAND=0; N_PASS=0; N_SUBST=0; N_UNKNOWN=0; N_TESTS=0
probe_all() {
  local d="$1" quiet="${2:-}" tier name cmd body surf probe rc verdict key seen="$NL" snap t0 secs dup
  PASS_FAST=(); PASS_FULL=(); N_CAND=0; N_PASS=0; N_SUBST=0; N_UNKNOWN=0; N_TESTS=0
  snap="$(mktemp "${TMPDIR:-/tmp}/arm-snap.XXXXXX")"
  guard snap "$d" "$snap"
  while IFS="$SEP" read -r tier name cmd body surf probe; do
    [ -n "${tier:-}" ] || continue
    N_CAND=$((N_CAND + 1))
    key="$surf|$body"
    dup=0
    if [ "$tier" != policy ]; then case "$seen" in *"$NL$key$NL"*) dup=1 ;; esac; fi
    if [ "$dup" -eq 1 ]; then
      verdict="SKIPPED (runs the same command as an earlier gate)"
    elif is_placeholder "${body:-$cmd}"; then
      verdict="REJECTED (placeholder: a gate that cannot fail is not a gate)"
    else
      seen="$seen$key$NL"
      t0=$(date +%s)
      run_probe "$d" "${probe:-$cmd}"; rc=$?
      secs=$(( $(date +%s) - t0 ))
      guard restore "$d" "$snap" "$name"
      if [ "$rc" -eq 0 ]; then
        verdict="passes (${secs}s)"
        N_PASS=$((N_PASS + 1))
        if [ "$tier" = policy ]; then
          verdict="passes (${secs}s; policy, does not count as a gate)"
        else
          N_SUBST=$((N_SUBST + 1))
        fi
        if [ "$tier" = fast ]; then PASS_FAST+=("$name$SEP$cmd$SEP$surf")
        else PASS_FULL+=("$name$SEP$cmd$SEP$surf"); fi
        [ "$tier" = full ] && N_TESTS=$((N_TESTS + 1))
      elif [ "$rc" -eq 124 ]; then
        N_UNKNOWN=$((N_UNKNOWN + 1))
        verdict="NO VERDICT (still running at ${PROBE_TIMEOUT}s; raise ARM_TIMEOUT to probe longer)"
      else
        verdict="REJECTED (exit $rc after ${secs}s)"
      fi
    fi
    [ -n "$quiet" ] || printf '  %-6s %-22s %-46s %s\n' "$tier" "$name" "$cmd" "$verdict"
  done < <(all_candidates "$d")
  if [ "$N_TESTS" -eq 0 ] && [ "${#PASS_FAST[@]}" -gt 0 ]; then PASS_FULL=("${PASS_FAST[@]}" ${PASS_FULL[@]+"${PASS_FULL[@]}"}); fi
  rm -f "$snap"
}

emit_config() {
  local r
  {
    for r in ${PASS_FAST[@]+"${PASS_FAST[@]}"}; do printf 'fast%s%s\n' "$SEP" "$r"; done
    for r in ${PASS_FULL[@]+"${PASS_FULL[@]}"}; do printf 'full%s%s\n' "$SEP" "$r"; done
  } | python3 -c '
import json, sys
tiers = {"fast": [], "full": []}
for line in sys.stdin.read().splitlines():
    tier, name, cmd, surface = line.split("\x1f")
    gate = {"name": name, "cmd": cmd}
    if surface:
        gate["surface"] = [surface]
    tiers[tier].append(gate)
def block(key):
    gates = tiers[key]
    if not gates:
        return "  \"%s\": []" % key
    return "  \"%s\": [\n%s\n  ]" % (key, ",\n".join("    " + json.dumps(g) for g in gates))
print("{\n" + ",\n".join(block(k) for k in ("fast", "full")) + "\n}")
'
}

do_detect() {
  say "candidates in: $TARGET"
  probe_all "$TARGET"
  say ""
  say "$N_PASS of $N_CAND candidate(s) pass here."
  [ "$N_UNKNOWN" -gt 0 ] && say "$N_UNKNOWN gave no verdict inside ${PROBE_TIMEOUT}s. That is unknown, not failing: re-run with a larger ARM_TIMEOUT before concluding anything about them."
  if [ "$N_SUBST" -eq 0 ]; then
    say "Nothing would be written: no lint, typecheck or test command passes, and policy gates do not count."
    say "An armed config that gates nothing certifies everything. Give this repo one command that passes first."
    return 1
  fi
  say ""
  emit_config
}

do_write() {
  probe_all "$TARGET" quiet
  if [ "$N_SUBST" -eq 0 ]; then
    say "REFUSING: no lint, typecheck or test command passes in $TARGET ($N_PASS of $N_CAND candidates pass; policy gates do not count)."
    [ "$N_UNKNOWN" -gt 0 ] && say "$N_UNKNOWN candidate(s) were still running at ${PROBE_TIMEOUT}s and gave no verdict. Try: ARM_TIMEOUT=1800 arm write"
    say "An armed config with nothing but policy gates would report enforcement that is not happening."
    say "Run 'arm detect' to see what was rejected and why."
    return 1
  fi
  mkdir -p "$TARGET/.claude"
  local out="$TARGET/.claude/gates.json" cfg r
  cfg="$(emit_config)"
  if [ -s "$out" ] && [ "$cfg" = "$(cat "$out")" ]; then
    say "already armed: $out matches what passes now"
  elif [ -s "$out" ]; then
    printf '%s\n' "$cfg" > "$out.new"
    say "$out exists: wrote $out.new. Merge it; overwriting a project's gate config is the irreversible surprise this avoids."
  else
    printf '%s\n' "$cfg" > "$out"
    say "armed: $out  (${#PASS_FAST[@]} fast, ${#PASS_FULL[@]} full, all verified passing)"
  fi
  for r in ${PASS_FULL[@]+"${PASS_FULL[@]}"}; do
    if [ "${r%%"$SEP"*}" = co-author ] && [ ! -f "$TARGET/.claude/gates/trailer-check.py" ] && [ -z "${ARM_INSTALLING:-}" ]; then
      say "the co-author gate runs .claude/gates/trailer-check.py, which is not installed here yet: run kit/install.sh."
    fi
  done
  return 0
}

EXPECTED_CONTROLS=21
selftest() {
  local tmp="${TMPDIR:-/tmp}/arm-selftest.$$" ok=0 ran=0 self
  self="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/$(basename "${BASH_SOURCE[0]:-$0}")"
  mkdir -p "$tmp"
  chk() {
    ran=$((ran + 1))
    if [ "$2" = 0 ]; then ok=$((ok + 1)); printf '  ok    %s\n' "$1"
    else printf '  FAIL  %s\n' "$1"; fi
  }
  mkrepo() { mkdir -p "$1"; ( cd "$1" && git init -q . && git config user.email h@h && git config user.name h ); }
  commit_all() { ( cd "$1" && git add -A >/dev/null 2>&1 && git commit -qm "${2:-init}" >/dev/null 2>&1 ); }
  pkg() { mkdir -p "$1"; printf '%s' "$2" > "$1/package.json"; }
  gate_names() { python3 -c 'import json,sys;print(",".join(g["name"] for g in json.load(open(sys.argv[1])).get(sys.argv[2],[])))' "$1/.claude/gates.json" "$2" 2>/dev/null; }
  count_procs() { ps -axo command= | grep -c "[s]leep $1"; }
  local green_pkg='{"scripts":{"test":"exit 0"}}' unique

  pkg "$tmp/green" "$green_pkg"
  bash "$self" write "$tmp/green" >/dev/null 2>&1
  [ "$(gate_names "$tmp/green" full)|$(gate_names "$tmp/green" fast)" = "js-test|" ]
  chk "a passing command is written to full, and only that" $?

  pkg "$tmp/red" '{"scripts":{"test":"exit 1"}}'
  bash "$self" write "$tmp/red" >/dev/null 2>&1
  [ ! -f "$tmp/red/.claude/gates.json" ]
  chk "a failing command is refused, and nothing is armed" $?

  pkg "$tmp/ph" '{"scripts":{"test":"echo TODO"}}'
  local ph_out; ph_out="$(bash "$self" detect "$tmp/ph" 2>&1)"
  printf '%s' "$ph_out" | grep -q 'placeholder'
  chk "a placeholder is rejected as a placeholder, not run" $?

  mkdir -p "$tmp/bare"
  bash "$self" write "$tmp/bare" >/dev/null 2>&1
  [ "$?" -ne 0 ] && [ ! -f "$tmp/bare/.claude/gates.json" ]
  chk "an undetectable repo is refused rather than armed empty" $?

  mkdir -p "$tmp/exists/.claude"
  pkg "$tmp/exists" "$green_pkg"
  printf '%s\n' '{"_mine":true,"fast":[],"full":[{"name":"x","cmd":"exit 0"}]}' > "$tmp/exists/.claude/gates.json"
  bash "$self" write "$tmp/exists" >/dev/null 2>&1
  grep -q '_mine' "$tmp/exists/.claude/gates.json" && [ -f "$tmp/exists/.claude/gates.json.new" ]
  chk "an existing config survives; the new one lands beside it" $?

  local red_rc green_rc
  green_rc=$( CLAUDE_PROJECT_DIR="$tmp/green" bash "$KIT_ROOT/bin/verify" full >/dev/null 2>&1; echo $? )
  python3 - "$tmp/green/.claude/gates.json" <<'PY'
import json, sys
p = sys.argv[1]; d = json.load(open(p))
d["full"] = [{"name": "always-red", "cmd": "exit 1"}]
json.dump(d, open(p, "w"))
PY
  red_rc=$( CLAUDE_PROJECT_DIR="$tmp/green" bash "$KIT_ROOT/bin/verify" full >/dev/null 2>&1; echo $? )
  [ "$green_rc $red_rc" = "0 1" ]
  chk "the written config is the shape the runner consumes (green 0, red 1)" $?

  mkdir -p "$tmp/script"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$tmp/script/selftest.sh"
  chmod +x "$tmp/script/selftest.sh"
  bash "$self" write "$tmp/script" >/dev/null 2>&1
  [ "$(gate_names "$tmp/script" full)" = "script-selftest.sh" ]
  chk "a manifest-less repo arms through its script entrypoint" $?

  mkdir -p "$tmp/fakebin" "$tmp/pyt/tests" "$tmp/jst/test"
  printf '#!/bin/sh\nexit 0\n' > "$tmp/fakebin/pytest"; chmod +x "$tmp/fakebin/pytest"
  : > "$tmp/pyt/tests/test_a.py"; : > "$tmp/jst/test/smoke.test.js"
  local py_out js_out
  py_out="$(PATH="$tmp/fakebin:$PATH" bash "$self" detect "$tmp/pyt" 2>&1)"
  js_out="$(PATH="$tmp/fakebin:$PATH" bash "$self" detect "$tmp/jst" 2>&1)"
  [ "$(printf '%s' "$py_out" | grep -c 'full   py-test-bare')$(printf '%s' "$js_out" | grep -c 'full   py-test-bare')" = "10" ]
  chk "bare pytest is offered where python tests exist and not for a test directory of another language" $?

  unique=$((70000 + RANDOM))
  mkdir -p "$tmp/slow"
  printf '%s\n' '#!/usr/bin/env bash' "sleep $unique &" "sleep $unique" 'exit 0' > "$tmp/slow/selftest.sh"
  chmod +x "$tmp/slow/selftest.sh"
  local slow_out; slow_out="$(ARM_TIMEOUT=2 bash "$self" detect "$tmp/slow" 2>&1)"
  printf '%s' "$slow_out" | grep -q 'NO VERDICT' \
    && ! printf '%s' "$slow_out" | grep -q 'REJECTED (exit' \
    && [ ! -f "$tmp/slow/.claude/gates.json" ]
  chk "a probe that outlives the budget is NO VERDICT, not REJECTED, and arms nothing" $?
  [ "$(count_procs "$unique")" = 0 ]
  chk "a timed-out probe leaves none of its processes behind" $?

  unique=$((70000 + RANDOM))
  ARM_TIMEOUT=$unique bash "$self" detect "$tmp/green" >/dev/null 2>&1
  [ "$(count_procs "$unique")" = 0 ]
  chk "probing leaves no timer process behind" $?

  mkdir -p "$tmp/contract/.claude"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$tmp/contract/selftest.sh"
  chmod +x "$tmp/contract/selftest.sh"
  printf '%s\n' '{"outcomes":[{"name":"o","expect":"e","check":"exit 0","control":"exit 1"}]}' \
    > "$tmp/contract/.claude/acceptance.json"
  local contract_out; contract_out="$(bash "$self" detect "$tmp/contract" 2>&1)"
  ! printf '%s' "$contract_out" | grep -q 'acceptance'
  chk "no acceptance gate is armed: verify done runs the contract itself" $?

  pkg "$tmp/mono/web" "$green_pkg"
  pkg "$tmp/mono/apps/web" "$green_pkg"
  pkg "$tmp/mono/packages/ui" "$green_pkg"
  pkg "$tmp/mono/deep/a/b" "$green_pkg"
  pkg "$tmp/mono/node_modules/x" "$green_pkg"
  bash "$self" write "$tmp/mono" >/dev/null 2>&1
  python3 - "$tmp/mono/.claude/gates.json" <<'PY'
import json, sys
want = [
    {"name": "apps-web-js-test", "cmd": "cd apps/web && npm test --silent", "surface": ["apps/web/**"]},
    {"name": "packages-ui-js-test", "cmd": "cd packages/ui && npm test --silent", "surface": ["packages/ui/**"]},
    {"name": "web-js-test", "cmd": "cd web && npm test --silent", "surface": ["web/**"]},
]
sys.exit(0 if json.load(open(sys.argv[1]))["full"] == want else 1)
PY
  chk "apps one and two levels down are armed with cd and their own surface; deeper and node_modules are not" $?

  pkg "$tmp/odd/my app" "$green_pkg"
  pkg "$tmp/odd/it's" "$green_pkg"
  bash "$self" write "$tmp/odd" >/dev/null 2>&1
  python3 - "$tmp/odd/.claude/gates.json" <<'PY'
import json, sys
want = [
    {"name": "it-s-js-test", "cmd": "cd 'it'\\''s' && npm test --silent", "surface": ["it's/**"]},
    {"name": "my-app-js-test", "cmd": "cd 'my app' && npm test --silent", "surface": ["my app/**"]},
]
sys.exit(0 if json.load(open(sys.argv[1]))["full"] == want else 1)
PY
  chk "directory names with spaces and quotes are quoted, probed and written as valid JSON" $?

  pkg "$tmp/tiers" '{"scripts":{"lint":"exit 0","typecheck":"sh -c \"exit 0\"","test":"sh -c \"exit 00\""}}'
  bash "$self" write "$tmp/tiers" >/dev/null 2>&1
  [ "$(gate_names "$tmp/tiers" fast)|$(gate_names "$tmp/tiers" full)" = "js-lint,js-typecheck|js-test" ]
  chk "with a passing test, lint and typecheck stay in fast: a stop runs only the tests" $?

  pkg "$tmp/lintonly" '{"scripts":{"lint":"exit 0"}}'
  bash "$self" write "$tmp/lintonly" >/dev/null 2>&1
  [ "$(gate_names "$tmp/lintonly" full)" = "js-lint" ]
  chk "with no passing test, lint is what a stop runs" $?

  pkg "$tmp/dup" '{"scripts":{"lint":"exit 0","typecheck":"exit 0","test":"sh -c \"exit 0\""}}'
  bash "$self" write "$tmp/dup" >/dev/null 2>&1
  [ "$(gate_names "$tmp/dup" fast)|$(gate_names "$tmp/dup" full)" = "js-lint|js-test" ]
  chk "a command that repeats an earlier gate is not armed twice" $?

  mkrepo "$tmp/policy"; mkdir -p "$tmp/policy/.claude"
  printf 'Co-Authored-By\n' > "$tmp/policy/.claude/forbidden-trailers"
  commit_all "$tmp/policy"
  bash "$self" write "$tmp/policy" >/dev/null 2>&1
  [ "$?" -ne 0 ] && [ ! -f "$tmp/policy/.claude/gates.json" ]
  chk "policy gates alone never arm a config" $?

  pkg "$tmp/policy" "$green_pkg"
  commit_all "$tmp/policy" pkg
  bash "$self" write "$tmp/policy" >/dev/null 2>&1
  [ "$(gate_names "$tmp/policy" full)" = "js-test,co-author" ] \
    && grep -q '"cmd": "python3 .claude/gates/trailer-check.py"' "$tmp/policy/.claude/gates.json"
  chk "co-author is armed beside a real gate when forbidden-trailers exists" $?

  mkrepo "$tmp/nopolicy"; pkg "$tmp/nopolicy" "$green_pkg"; commit_all "$tmp/nopolicy"
  bash "$self" write "$tmp/nopolicy" >/dev/null 2>&1
  [ "$(gate_names "$tmp/nopolicy" full)" = "js-test" ]
  chk "co-author is not armed without forbidden-trailers" $?

  mkrepo "$tmp/fx"
  pkg "$tmp/fx" '{"scripts":{"lint":"printf z > cache.bin","test":"printf x > package-lock.json && printf y > tracked.txt"}}'
  printf 'cache.bin\n' > "$tmp/fx/.gitignore"
  printf 'orig' > "$tmp/fx/tracked.txt"; printf 'orig' > "$tmp/fx/other.txt"
  commit_all "$tmp/fx"
  printf 'mine' > "$tmp/fx/wip.txt"; printf 'edited' > "$tmp/fx/other.txt"
  local fx_out fx_state=""
  fx_out="$(bash "$self" write "$tmp/fx" 2>&1)"
  [ ! -e "$tmp/fx/package-lock.json" ] && fx_state="$fx_state removed"
  [ "$(cat "$tmp/fx/tracked.txt")" = orig ] && fx_state="$fx_state restored"
  [ "$(cat "$tmp/fx/wip.txt")" = mine ] && fx_state="$fx_state kept-untracked"
  [ "$(cat "$tmp/fx/other.txt")" = edited ] && fx_state="$fx_state kept-edit"
  [ -e "$tmp/fx/cache.bin" ] && fx_state="$fx_state left-ignored"
  printf '%s' "$fx_out" | grep -q 'created package-lock.json (removed)' && fx_state="$fx_state noted"
  [ "$(printf '%s' "$fx_out" | grep -c 'left 1 ignored')" = 1 ] && fx_state="$fx_state said-once"
  [ "$fx_state" = " removed restored kept-untracked kept-edit left-ignored noted said-once" ]
  chk "a probe's own files are removed and restored, your work and ignored files are untouched" $?

  rm -rf "$tmp"
  [ "$ran" -eq "$EXPECTED_CONTROLS" ] || { printf '  FAIL  ran %s controls, expected %s\n' "$ran" "$EXPECTED_CONTROLS"; ok=-1; }
  echo
  if [ "$ok" -eq "$EXPECTED_CONTROLS" ]; then echo "SELF-TEST PASSED  ($EXPECTED_CONTROLS checks)"; return 0
  else echo "SELF-TEST FAILED  ($ok of $EXPECTED_CONTROLS checks)"; return 1; fi
}

case "$CMD" in
  detect)   do_detect ;;
  write)    do_write ;;
  selftest) selftest ;;
  *) say "usage: arm {detect|write} [dir] | arm selftest"; exit 2 ;;
esac
