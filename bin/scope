#!/usr/bin/env python3
import fnmatch
import json
import os
import subprocess
import sys

FORCE_ALL = (
    "package.json", "package-lock.json", "yarn.lock", "pnpm-lock.yaml",
    "requirements*.txt", "pyproject.toml", "uv.lock", "poetry.lock",
    "Dockerfile*", "docker-compose*.y*ml",
    ".github/**", "**/migrations/**", "**/alembic/**",
    ".claude/gates.json", ".claude/acceptance.json",
)

HARNESS_OUTPUTS = (
    ".claude/.gate-attempts",
    ".claude/evidence/**",
    ".claude/evidence",
    ".claude/work/**",
    ".agents/**",
    ".claude-flow/**",
    ".swarm/**",
    ".hive-mind/**",
    "agentdb.rvf",
    "agentdb.rvf.lock",
    "ruvector.db",
    ".claude/.gate-green",
    ".claude/.gate-stalled",
    ".claude/.sessions/**",
    ".claude/agents/**",
    ".claude/commands/**",
    ".claude/helpers/**",
    ".claude/skills/**",
    ".claude/plugins/**",
    ".claude/memory.db",
    ".claude/proven-config.json",
    ".claude/.proven-config-version",
    ".quality-baseline/**",
    ".claude/gates.json.new",
    ".claude/gates.json.surfaced",
    ".claude/gates.json.unverified",
)

EXPECTED_CONTROLS = 8

def sh(args, cwd):
    try:
        p = subprocess.run(args, cwd=cwd, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, text=True, timeout=60)
        return p.stdout
    except (OSError, subprocess.SubprocessError):
        return ""

def changed_files(root):
    base = os.environ.get("VERIFY_BASE", "origin/main")
    out = set()
    for args in (
        ["git", "diff", "--name-only", "--diff-filter=ACM", "%s...HEAD" % base],
        ["git", "diff", "--name-only", "--diff-filter=ACM", "HEAD"],
        ["git", "diff", "--name-only", "--diff-filter=ACM", "--cached"],
        ["git", "ls-files", "--others", "--exclude-standard"],
    ):
        out.update(x for x in sh(args, root).splitlines() if x.strip())
    out = {f for f in out if not any_match(f, HARNESS_OUTPUTS)}
    renamed = bool(sh(["git", "diff", "--diff-filter=R", "--name-only",
                       "%s...HEAD" % base], root).strip())
    return sorted(out), renamed

def matches(path, pattern):
    if fnmatch.fnmatch(path, pattern):
        return True
    if pattern.startswith("**/") and fnmatch.fnmatch(path, pattern[3:]):
        return True
    if pattern.endswith("/**") and path.startswith(pattern[:-3] + "/"):
        return True
    return False

def any_match(path, patterns):
    return any(matches(path, p) for p in patterns)

def plan(root, gates=None, files=None, renamed=None):
    if gates is None:
        cfg = os.path.join(root, ".claude", "gates.json")
        try:
            with open(cfg, encoding="utf-8") as fh:
                gates = (json.load(fh).get("full") or [])
        except (OSError, ValueError):
            return [], "the gate config could not be read"
    if files is None:
        files, renamed = changed_files(root)

    if not files:
        return [(g.get("name", "?"), True, "no change set — cannot prove anything is safe")
                for g in gates], "the change set is empty"
    if renamed:
        return [(g.get("name", "?"), True, "rename detected") for g in gates], \
               "a rename makes path-based selection unreliable"

    hit = [f for f in files if any_match(f, FORCE_ALL)]
    if hit:
        return [(g.get("name", "?"), True, "shared surface touched") for g in gates], \
               "%s changes what every gate runs against" % hit[0]

    declared = [p for g in gates for p in (g.get("surface") or [])]
    orphans = [f for f in files if not any_match(f, declared)]
    if orphans:
        return [(g.get("name", "?"), True, "unclaimed file in the diff") for g in gates], \
               "%s matches no gate's declared surface" % orphans[0]

    decisions = []
    for g in gates:
        name = g.get("name", "?")
        surface = g.get("surface") or []
        if not surface:
            decisions.append((name, True, "no declared surface — always runs"))
            continue
        touched = [f for f in files if any_match(f, surface)]
        if touched:
            decisions.append((name, True, "touched: %s" % touched[0]))
        else:
            decisions.append((name, False, "nothing in the diff matches %s" % ", ".join(surface)))
    return decisions, None

def report(root):
    files, renamed = changed_files(root)
    decisions, forced = plan(root, files=files, renamed=renamed)
    if not decisions:
        print("no gates to plan for%s" % (" — %s" % forced if forced else ""))
        return 1 if forced else 0

    print("changed files: %d" % len(files))
    if forced:
        print("FULL LADDER FORCED: %s" % forced)
    print()
    skipped = 0
    for name, run, reason in decisions:
        if run:
            print("  RUN   %-20s %s" % (name, reason))
        else:
            skipped += 1
            print("  SKIP  %-20s %s" % (name, reason))
    print()
    if skipped:
        print("%d of %d gate(s) would not run. This is a narrower claim than a full pass: "
              "those gates are unexecuted, not green." % (skipped, len(decisions)))
    else:
        print("All %d gate(s) would run." % len(decisions))
    return 0

def selftest():
    passed = ran = 0

    def chk(label, cond):
        nonlocal passed, ran
        ran += 1
        if cond:
            passed += 1
            print("  ok    %s" % label)
        else:
            print("  FAIL  %s" % label)

    G = [
        {"name": "fe-test", "surface": ["web/**"]},
        {"name": "be-test", "surface": ["api/**"]},
        {"name": "cheat-scan"},
    ]

    def run(files, renamed=False, gates=None):
        return plan("/nonexistent", gates=gates if gates is not None else G,
                    files=files, renamed=renamed)

    def runs(files, **kw):
        d, f = run(files, **kw)
        return f, dict((n, r) for n, r, _ in d)

    def forced(files, **kw):
        f, by = runs(files, **kw)
        return f is not None and all(by.values())

    fa, a = runs(["api/users.py"])
    fb, b = runs(["web/login.tsx"])
    chk("a one-side change skips only the other side's gate",
        fa is None and a["be-test"] and not a["fe-test"] and fb is None and b["fe-test"] and not b["be-test"])

    chk("a gate with no surface always runs", a["cheat-scan"])

    chk("a file matching no surface forces the full ladder", forced(["docs/readme.md"]))

    chk("a lockfile, migration or gate-config change forces the full ladder",
        forced(["api/users.py", "package-lock.json"]) and forced(["api/db/migrations/003.py"])
        and forced([".claude/gates.json"]))

    chk("an empty change set or a rename runs everything",
        forced([]) and forced(["web/login.tsx"], renamed=True))

    f, by = runs(["README.md"], gates=[{"name": "docs", "surface": ["**/*.md"]},
                                        {"name": "be-test", "surface": ["api/**"]}])
    chk("'**/' matches a root-level file", f is None and by["docs"] and not by["be-test"])

    import io, shutil, tempfile
    from contextlib import redirect_stdout
    d = tempfile.mkdtemp(prefix="scope-skip-")
    os.makedirs(os.path.join(d, ".claude"), exist_ok=True)
    with open(os.path.join(d, ".claude", "gates.json"), "w") as fh:
        fh.write("{not json")
    quiet = True
    for root in ("/nonexistent/no/repo/here", d):
        buf = io.StringIO()
        with redirect_stdout(buf):
            rc = skip_list(root)
        quiet = quiet and rc == 0 and buf.getvalue().strip() == ""
    shutil.rmtree(d, ignore_errors=True)
    chk("the skip list is empty whenever scope cannot decide", quiet)

    excluded = [".claude/.gate-attempts", ".claude/evidence/latest.json", ".agents/skills/x/SKILL.md",
                ".claude-flow/cache.json", ".claude/gates.json.surfaced", ".claude/gates.json.new"]
    chk("harness output and agent tooling are excluded, source and live config are not",
        all(any_match(x, HARNESS_OUTPUTS) for x in excluded)
        and not any_match("api/users.py", HARNESS_OUTPUTS)
        and not any_match(".claude/gates.json", HARNESS_OUTPUTS)
        and any_match(".claude/gates.json", FORCE_ALL))

    if ran != EXPECTED_CONTROLS:
        print("  FAIL  ran %d controls, expected %d" % (ran, EXPECTED_CONTROLS))
        passed = -1
    print()
    if passed == EXPECTED_CONTROLS:
        print("SELF-TEST PASSED  (%d checks)" % EXPECTED_CONTROLS)
        return 0
    print("SELF-TEST FAILED  (%d of %d checks)" % (passed, EXPECTED_CONTROLS))
    return 1

def skip_list(root):
    try:
        decisions, forced = plan(root)
    except Exception as exc:
        print("scope: could not decide (%s)" % exc, file=sys.stderr)
        return 2
    if forced or not decisions:
        return 0
    for name, run, _reason in decisions:
        if not run:
            print(name)
    return 0

def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "plan"
    if cmd in ("selftest", "--self-test"):
        return selftest()
    if cmd == "plan":
        root = args[1] if len(args) > 1 else os.getcwd()
        return report(root)
    if cmd == "skip":
        root = args[1] if len(args) > 1 else os.getcwd()
        return skip_list(root)
    print("usage: scope {plan [dir]|skip [dir]|selftest}", file=sys.stderr)
    return 2

if __name__ == "__main__":
    sys.exit(main())
