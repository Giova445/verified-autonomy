#!/usr/bin/env bash
set -uo pipefail

TD_SRC="${TD_SRC:-^(src|lib|app)/}"
TD_TESTS="${TD_TESTS:-(^|/)(tests?|__tests__|spec)/}"
TD_MIN="${TD_MIN:-20}"

ASSERT_RE='(^|[^A-Za-z0-9_])(assert|expect|require)([^A-Za-z0-9_]|$)|assertEqual|assertTrue|assertFalse|assertRaises|assertIn|assertNotEqual|assert_eq!|assert_ne!|\.should|XCTAssert|t\.Error|t\.Fatal'

say() { printf '%s\n' "$*" >&2; }

resolve_base() {
  local b="${1:-}"
  if [ -n "$b" ] && git rev-parse --verify --quiet "$b" >/dev/null 2>&1; then printf '%s' "$b"; return; fi
  if [ -n "${TD_BASE:-}" ] && git rev-parse --verify --quiet "$TD_BASE" >/dev/null 2>&1; then printf '%s' "$TD_BASE"; return; fi
  git rev-parse --verify --quiet '@{upstream}' >/dev/null 2>&1 && { printf '@{upstream}'; return; }
  for c in origin/HEAD origin/main origin/master; do
    git rev-parse --verify --quiet "$c" >/dev/null 2>&1 && { printf '%s' "$c"; return; }
  done
  printf ''
}

collect_diff() {
  local base="$1" head="$2"
  {
    [ "$base" != "$head" ] && git diff "$base"...HEAD 2>/dev/null
    git diff HEAD 2>/dev/null
    git diff --cached 2>/dev/null
    for f in $(git ls-files --others --exclude-standard 2>/dev/null); do
      git diff --no-index /dev/null "$f" 2>/dev/null
    done
  }
}

run_check() {
  git rev-parse --verify --quiet HEAD >/dev/null 2>&1 || {
    say "test-delta: no commits to compare against — refusing to certify"; return 1; }

  local base; base="$(resolve_base "${1:-}")"
  if [ -z "$base" ]; then
    say "test-delta: no baseline. Pass a base ref, set TD_BASE, or add an upstream."
    say "Refusing to certify — a gate that cannot see the change set must not pass it."
    return 1
  fi

  local base_sha head_sha dirty
  base_sha="$(git rev-parse "$base" 2>/dev/null)"
  head_sha="$(git rev-parse HEAD 2>/dev/null)"
  dirty="$(git status --porcelain 2>/dev/null)"
  if [ "$base_sha" = "$head_sha" ] && [ -z "$dirty" ]; then
    say "test-delta: baseline ($base) is HEAD and the tree is clean — no visible change set."
    say "Committed work is behind the baseline and cannot be inspected. Pass the ref the"
    say "work started from, or set TD_BASE. Refusing to certify."
    return 1
  fi

  local diff; diff="$(collect_diff "$base_sha" "$head_sha")"
  [ -z "$diff" ] && { echo "test-delta: no changes"; return 0; }

  local counts
  counts="$(printf '%s' "$diff" | awk -v src="$TD_SRC" -v tst="$TD_TESTS" -v are="$ASSERT_RE" '
    /^\+\+\+ / {
      path = $2; sub(/^b\//, "", path)
      is_src  = (path ~ src)
      is_test = (path ~ tst)
      next
    }
    /^[+][^+]/ {
      if (is_test) { line = substr($0,2); if (line ~ are) tadd++ }
      else if (is_src) sadd++
      next
    }
    /^[-][^-]/ {
      if (is_test) { line = substr($0,2); if (line ~ are) tdel++ }
      next
    }
    END { printf "%d %d %d", sadd+0, tadd+0, tdel+0 }
  ')"

  local src_added test_asserts_added test_asserts_removed
  read -r src_added test_asserts_added test_asserts_removed <<< "$counts"
  for v in "$src_added" "$test_asserts_added" "$test_asserts_removed"; do
    case "${v:-}" in
      ''|*[!0-9]*)
        say "test-delta: could not read the diff (counts=\"$counts\") — refusing to certify"
        return 1 ;;
    esac
  done
  local net=$(( test_asserts_added - test_asserts_removed ))

  if [ "$net" -lt 0 ]; then
    say "GATE FAILED — committed test assertions went down (net ${net})."
    say "  added ${test_asserts_added}, removed ${test_asserts_removed}"
    say "Deleting tests is a coverage regression whether or not production code moved."
    say "If a test was genuinely wrong, replace it; do not just remove it."
    return 1
  fi

  if [ "$src_added" -eq 0 ]; then
    echo "test-delta: no production changes (${net} net test assertions)"
    return 0
  fi

  local required=$(( (src_added + TD_MIN - 1) / TD_MIN ))
  [ "$required" -lt 1 ] && required=1

  echo "test-delta: +${src_added} production lines, ${net} net test assertions (need ${required})"

  if [ "$net" -lt "$required" ]; then
    say ""
    say "GATE FAILED — production code changed without matching test coverage."
    say "  production lines added : ${src_added}"
    say "  net test assertions    : ${net}   (added ${test_asserts_added}, removed ${test_asserts_removed})"
    say "  required               : ${required}  (1 per ${TD_MIN} production lines)"
    say ""
    say "Manual checks you ran and discarded do not count. A behaviour with no committed"
    say "test is a behaviour nothing protects — the next change breaks it silently."
    say "Write the tests. Do not lower TD_MIN to pass."
    return 1
  fi
  echo "test-delta: ok"
  return 0
}

selftest() {
  local pass=0 fail=0 tmp
  chk() { if [ "$2" = "$3" ]; then printf '  ok    %-46s (%s)\n' "$1" "$3"; pass=$((pass+1));
          else printf '  FAIL  %-46s want=%s got=%s\n' "$1" "$3" "$2"; fail=$((fail+1)); fi; }

  tmp="$(mktemp -d)"
  ( cd "$tmp" && git init -q . && git config user.email t@t && git config user.name t
    mkdir -p src tests
    printf 'def a(): return 1\n' > src/m.py
    printf 'from src.m import a\ndef test_a(): assert a() == 1\n' > tests/t.py
    git add -A >/dev/null && git commit -qm base >/dev/null ) 2>/dev/null

  cd "$tmp" || return 1

  printf 'def a(): return 1\ndef b(): return 2\ndef c(): return 3\n' > src/m.py
  ( run_check HEAD >/dev/null 2>&1 ); chk "production grows, no tests -> fail" "$?" "1"

  printf 'from src.m import a, b\ndef test_a(): assert a() == 1\ndef test_b(): assert b() == 2\n' > tests/t.py
  ( run_check HEAD >/dev/null 2>&1 ); chk "production grows, tests added -> pass" "$?" "0"

  printf 'from src.m import a\ndef test_only(): assert a() == 1\n' > tests/t.py
  printf 'def a(): return 1\ndef b(): return 2\ndef c(): return 3\ndef d(): return 4\n' > src/m.py
  ( run_check HEAD >/dev/null 2>&1 ); chk "assertions removed -> fail" "$?" "1"

  git checkout -q -- . 2>/dev/null
  printf '# notes\n' > README.md
  ( run_check HEAD >/dev/null 2>&1 ); chk "non-production change -> pass" "$?" "0"

  printf 'def a(): return 1\ndef b(): return 2\ndef c(): return 3\n' > src/m.py
  printf 'from src.m import a\n# fixture\nFIX = 1\n# more setup\nX = 2\ndef test_a(): assert a() == 1\n' > tests/t.py
  ( run_check HEAD >/dev/null 2>&1 ); chk "test file grows w/o assertions -> fail" "$?" "1"

  git checkout -q -- . 2>/dev/null; rm -f README.md
  mkdir -p src
  { echo 'class Scheduler:'; for i in $(seq 1 30); do echo "    def op$i(self): return $i"; done; } > src/scheduler.py
  ( run_check HEAD >/dev/null 2>&1 ); chk "new untracked module, no tests -> fail" "$?" "1"

  { echo 'from src.scheduler import Scheduler'; echo 'def test_ops():';
    for i in $(seq 1 12); do echo "    assert Scheduler().op$i() == $i"; done; } > tests/t_sched.py
  ( run_check HEAD >/dev/null 2>&1 ); chk "same module with a real suite -> pass" "$?" "0"

  printf 'from src.scheduler import Scheduler\ndef test_one(): assert Scheduler()\n' > tests/t_sched.py
  ( run_check HEAD >/dev/null 2>&1 ); chk "one token assertion for 30 lines -> fail" "$?" "1"

  git checkout -q -- . 2>/dev/null; rm -f README.md tests/t_sched.py 2>/dev/null
  { echo 'class S:'; for i in $(seq 1 30); do echo "    def op$i(self): return $i"; done; } > src/scheduler.py
  local scaffold; scaffold="$(git rev-parse HEAD)"
  git add -A >/dev/null 2>&1; git commit -qm "impl with no tests" >/dev/null 2>&1

  ( run_check >/dev/null 2>&1 ); chk "committed, clean tree, no baseline -> refuse" "$?" "1"
  ( run_check "$scaffold" >/dev/null 2>&1 ); chk "committed w/ explicit base, no tests -> fail" "$?" "1"
  ( TD_BASE="$scaffold" run_check >/dev/null 2>&1 ); chk "TD_BASE honoured -> fail" "$?" "1"

  { echo 'from src.scheduler import S'; echo 'def test_ops():';
    for i in $(seq 1 12); do echo "    assert S().op$i() == $i"; done; } > tests/t.py
  git add -A >/dev/null 2>&1; git commit -qm "add suite" >/dev/null 2>&1
  ( run_check "$scaffold" >/dev/null 2>&1 ); chk "committed w/ real suite -> pass" "$?" "0"
  local withtests; withtests="$(git rev-parse HEAD)"
  printf 'def test_nothing(): pass\n' > tests/t.py
  git add -A >/dev/null 2>&1; git commit -qm "gut the suite" >/dev/null 2>&1
  ( run_check "$withtests" >/dev/null 2>&1 ); chk "suite gutted in a commit -> fail" "$?" "1"

  ( run_check >/dev/null 2>&1 ); chk "local branch never auto-used as base" "$?" "1"

  local bare; bare="$(mktemp -d)"; cd "$bare" && git init -q .
  ( run_check >/dev/null 2>&1 ); chk "no base to compare -> refuse" "$?" "1"

  cd /; rm -rf "$tmp" "$bare" 2>/dev/null
  echo
  if [ "$fail" -eq 0 ]; then echo "TEST-DELTA SELF-TEST PASSED  ($pass checks)"; return 0
  else echo "TEST-DELTA SELF-TEST FAILED  ($fail of $((pass+fail)))"; return 1; fi
}

case "${1:-check}" in
  selftest) selftest ;;
  check)    run_check "${2:-}" ;;
  *)        run_check "${1:-}" ;;
esac
