#!/usr/bin/env bash
set -uo pipefail

ROOT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
CONFIG="$ROOT/.claude/gates.json"
EVIDENCE="$ROOT/.claude/evidence"
STATE="$ROOT/.claude/.gate-attempts"
STALL="$ROOT/.claude/.gate-stalled"
BASE="${VERIFY_BASE:-origin/main}"
MAX_BLOCKS="${GATE_MAX_BLOCKS:-3}"
HOOK=0
FAILED=""

for a in "$@"; do [ "$a" = "--hook" ] && HOOK=1; done
die_code() { [ "$HOOK" -eq 1 ] && exit 2 || exit 1; }
say() { printf '%s\n' "$*" >&2; }

mkdir -p "$EVIDENCE"

preflight() {
  local bad=0

  if command -v codegraph >/dev/null 2>&1; then
    gs="$(codegraph status "$ROOT" 2>&1)"
    if [ -n "$gs" ] && ! printf '%s' "$gs" | grep -qiE "not initialized|no such|not found"; then
      say "  graph   : ok"
    else
      say "  graph   : NOT INITIALIZED — run 'codegraph init -i'."
      say "            Blast radius and test selection are UNAVAILABLE this run."
      say "            You are at grep precision. Say so in your report."
    fi
  else
    say "  graph   : codegraph not on PATH (degraded, see above)"
  fi

  if [ -f "$CONFIG" ]; then
    if python3 -m json.tool "$CONFIG" >/dev/null 2>&1; then say "  gates   : parseable"
    else say "  gates   : INVALID JSON in $CONFIG"; bad=1; fi
  fi

  local reg="$EVIDENCE/assumptions.jsonl"
  if [ -f "$reg" ] && grep -q '"status"[[:space:]]*:[[:space:]]*"open"' "$reg" 2>/dev/null; then
    say "  assume  : OPEN assumptions remain — resolve by reading code or asking. Never infer."
    grep '"status"[[:space:]]*:[[:space:]]*"open"' "$reg" | head -5 | sed 's/^/            /' >&2
    bad=1
  else
    say "  assume  : clean"
  fi

  return $bad
}

blast() {
  local sym="${1:?usage: verify blast <symbol>}"
  command -v codegraph >/dev/null 2>&1 || { say "codegraph not installed"; return 1; }
  echo "## Blast radius: $sym"
  codegraph query "$sym" --json 2>/dev/null || codegraph query "$sym" 2>/dev/null
  echo
  echo "## Callers (reverse-dependency closure, depth 1)"
  codegraph context "callers of $sym" 2>/dev/null | head -60
  echo
  echo "NOTE: union with reference-edges by hand for DI-heavy code (Depends/@Injectable)."
}

tests_for_diff() {
  local changed; changed="$(
    {
      git -C "$ROOT" diff --name-only --diff-filter=ACM "$BASE"...HEAD 2>/dev/null
      git -C "$ROOT" diff --name-only --diff-filter=ACM HEAD           2>/dev/null
      git -C "$ROOT" diff --name-only --diff-filter=ACM --cached       2>/dev/null
      git -C "$ROOT" ls-files --others --exclude-standard              2>/dev/null
    } | sort -u
  )"
  [ -z "$changed" ] && { echo "(no changes vs $BASE)"; return 0; }

  if printf '%s\n' "$changed" | grep -qE '(package(-lock)?\.json|requirements.*\.txt|pyproject\.toml|uv\.lock|Dockerfile|\.github/|alembic/|migrations?/)'; then
    echo "ALL  # config/dependency/migration touched — full suite required"
    return 0
  fi
  if git -C "$ROOT" diff --diff-filter=R --name-only "$BASE"...HEAD 2>/dev/null | grep -q .; then
    echo "ALL  # rename detected — graph selection unreliable"
    return 0
  fi
  printf '%s\n' "$changed"
}

run_tier() {
  local tier="$1"
  [ -f "$CONFIG" ] || { say "no $CONFIG — nothing to enforce"; return 0; }

  local gates
  if ! gates="$(python3 -c '
import json,sys
print(json.dumps(json.load(open(sys.argv[1])).get(sys.argv[2],[])))' "$CONFIG" "$tier" 2>/dev/null)"; then
    CONFIG_ERROR="gate config is unparseable"
    return 0
  fi

  local n; n="$(python3 -c 'import json,sys;print(len(json.loads(sys.argv[1])))' "$gates" 2>/dev/null)"
  [ -z "$n" ] && { CONFIG_ERROR="gate list is unreadable"; return 0; }

  if [ "$n" -eq 0 ]; then
    [ "$tier" = full ] && CONFIG_ERROR="tier 'full' declares no gates"
    return 0
  fi

  SCOPE_SKIPPED=""
  if [ "$tier" = full ] && [ "${VERIFY_SCOPE:-1}" != "0" ]; then
    local self_dir scope_bin has_surface
    self_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
    scope_bin="$self_dir/scope"
    has_surface="$(python3 -c '
import json,sys
try: g=json.load(open(sys.argv[1])).get("full") or []
except Exception: print("no"); raise SystemExit
print("yes" if any(x.get("surface") for x in g) else "no")' "$CONFIG" 2>/dev/null || echo no)"
    if [ "$has_surface" = yes ] && [ -x "$scope_bin" ]; then
      SCOPE_SKIPPED="$(python3 "$scope_bin" skip "$ROOT" 2>/dev/null || true)"
    fi
  fi

  RESULTS="[]"
  for i in $(seq 0 $((n-1))); do
    local name cmd out code start dur
    name="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1])[int(sys.argv[2])]["name"])' "$gates" "$i")"
    cmd="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1])[int(sys.argv[2])]["cmd"])' "$gates" "$i")"
    case "$cmd" in
      echo\ *|:|""|" "*)
        say "  ✗ $name — placeholder command ($cmd), not a gate"
        CONFIG_ERROR="gate '$name' is a placeholder"
        continue ;;
    esac

    if [ -n "$SCOPE_SKIPPED" ] && printf '%s\n' "$SCOPE_SKIPPED" | grep -qxF "$name"; then
      say "  ⊘ $name — scoped out: nothing in the diff touches its declared surface"
      RESULTS="$(python3 -c '
import json,sys
r=json.loads(sys.argv[1])
r.append({"gate":sys.argv[2],"command":sys.argv[3],"skipped":True,
          "reason":"no changed file matches the declared surface of this gate",
          "executed_by":"harness"})
print(json.dumps(r))' "$RESULTS" "$name" "$cmd")"
      SKIPPED_N=$((${SKIPPED_N:-0} + 1))
      continue
    fi

    start=$(date +%s)
    out="$(cd "$ROOT" && eval "$cmd" 2>&1)"; code=$?
    dur=$(( ($(date +%s) - start) * 1000 ))

    if [ $code -eq 0 ]; then say "  ✓ $name (${dur}ms)"; else say "  ✗ $name (exit $code)"; fi

    RESULTS="$(python3 -c '
import json,sys,hashlib
r=json.loads(sys.argv[1])
r.append({"gate":sys.argv[2],"command":sys.argv[3],"exit_code":int(sys.argv[4]),
          "stdout_sha256":hashlib.sha256(sys.argv[5].encode()).hexdigest(),
          "duration_ms":int(sys.argv[6]),"executed_by":"harness"})
print(json.dumps(r))' "$RESULTS" "$name" "$cmd" "$code" "$out" "$dur")"

    [ $code -ne 0 ] && FAILED="${FAILED}
── GATE FAILED: ${name}
   command : ${cmd}
   exit    : ${code}
$(printf '%s' "$out" | tail -30 | sed 's/^/   │ /')
"
  done
}

fingerprint() {
  local ex=(-- . ':(exclude).claude' ':(exclude).quality-baseline')
  {
    git -C "$ROOT" rev-parse HEAD 2>/dev/null
    git -C "$ROOT" diff HEAD "${ex[@]}" 2>/dev/null
    (cd "$ROOT" && git ls-files --others --exclude-standard -z "${ex[@]}" 2>/dev/null | xargs -0 shasum 2>/dev/null)
    (cd "$ROOT" && shasum .claude/gates.json .claude/acceptance.json 2>/dev/null)
  } | shasum -a 256 | cut -d' ' -f1
}

untouched_this_session() {
  local base="${VERIFY_SESSION_BASELINE:-}"
  [ -n "$base" ] && [ -s "$base" ] && [ "$(cat "$base")" = "$(fingerprint)" ]
}

accept_py() {
  local here p
  here="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
  for p in "$here/../benchmark/gates/acceptance.py" "$here/../gates/acceptance.py" "$ROOT/.claude/gates/acceptance.py"; do
    [ -f "$p" ] && { printf '%s' "$p"; return 0; }
  done
  return 1
}

product() {
  PRODUCT_STATUS="open"; PRODUCT_MSG=""
  if [ -n "$FAILED$CONFIG_ERROR" ] && [ -f "$ROOT/.claude/acceptance.json" ]; then
    PRODUCT_STATUS="not run"; return
  fi
  local py out
  py="$(accept_py)" || { PRODUCT_MSG="product : CANNOT RUN - acceptance.py is neither beside bin/verify nor in .claude/gates/"; return; }
  (cd "$ROOT" && python3 "$py" . --results "$EVIDENCE/product.json") > "$EVIDENCE/product.txt" 2>&1
  out="$(python3 "$py" --summarize "$EVIDENCE/product.json")"
  PRODUCT_STATUS="$(printf '%s\n' "$out" | head -1)"
  PRODUCT_MSG="$(printf '%s\n' "$out" | tail -n +2)"
}

write_bundle() {
  local sha; sha="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
  python3 -c '
import json,sys,datetime
g=json.loads(sys.argv[1]); err=sys.argv[3] if len(sys.argv)>3 else ""
product=sys.argv[4]
ok = bool(g) and all(x.get("exit_code")==0 for x in g if not x.get("skipped")) and not err and product in ("held","not run")
out={"commit_sha":sys.argv[2],"product":product,
  "generated_at":datetime.datetime.now(datetime.timezone.utc).isoformat(),
  "gates":g,"all_green":ok,
  "trust":"self-reported by the process under test; not a receipt",
  "verified_by":"producer"}
if err: out["error"]=err
elif not g: out["error"]="no gates executed"
print(json.dumps(out,indent=2))' \
  "${RESULTS:-[]}" "$sha" "${CONFIG_ERROR:-}" "${PRODUCT_STATUS:-not run}" > "$EVIDENCE/latest.json"
}

attempts=0; last_fp=""
[ -f "$STATE" ] && read -r attempts last_fp < "$STATE" 2>/dev/null
case "$attempts" in ''|*[!0-9]*) attempts=0 ;; esac
refuse() { echo "$((attempts + 1)) $(fingerprint)" > "$STATE"; }

case "${1:-done}" in
  preflight) say "preflight:"; preflight || exit 1 ;;
  blast)     shift; blast "$@" ;;
  tests)     tests_for_diff ;;
  fast)      say "fast gates:"; run_tier fast; [ -n "${CONFIG_ERROR:-}" ] && { say "REFUSING TO CERTIFY: ${CONFIG_ERROR}. Fix .claude/gates.json — a gate set that cannot be read is not a passing gate set."; die_code; }; [ -n "$FAILED" ] && { say "$FAILED"; die_code; }; say "fast: GREEN" ;;
  full)      say "full gates:"; run_tier full; write_bundle
      if [ -n "${CONFIG_ERROR:-}" ]; then
        refuse
        say "REFUSING TO CERTIFY: ${CONFIG_ERROR}."
        say "Fix .claude/gates.json — a gate set that cannot be read is not a passing gate set."
        die_code
      fi
      [ -n "$FAILED" ] && { say "$FAILED"; die_code; }
      if [ "${SKIPPED_N:-0}" -gt 0 ]; then
        say "full: GREEN for what ran — ${SKIPPED_N} gate(s) scoped out and UNEXECUTED"
      else say "full: GREEN"; fi ;;
  done|--hook)
      fp="$(fingerprint)"
      if [ -f "$STALL" ] && [ "$(cat "$STALL")" = "$fp" ]; then
        say "STALLED: nothing in this repo has changed since a refusal that retrying could not clear."
        say "Not done. Stopping is allowed; the gates run again once the repo changes."
        exit 0
      fi
      if [ -n "$last_fp" ] && [ "$last_fp" = "$fp" ]; then
        rm -f "$STATE"; echo "$fp" > "$STALL"
        say "NO PROGRESS: refused before, and nothing in the repo has changed since, so another"
        say "attempt cannot turn out differently. Not done. Write a BLOCKED report: the failing gate,"
        say "what you tried, the decision needing a human, a recommendation. This stop is allowed."
        exit 0
      fi
      if [ "$attempts" -gt "$MAX_BLOCKS" ]; then
        rm -f "$STATE"
        say "CIRCUIT BREAKER: the blocked report was requested; this stop is allowed so a person can review it."
        exit 0
      fi
      if [ "$attempts" -eq "$MAX_BLOCKS" ]; then
        refuse
        say "CIRCUIT BREAKER after $attempts blocked attempts. Stop retrying."
        say "Write a BLOCKED report: (1) failing gate + command + exit + stderr,"
        say "(2) what you tried and why each failed, (3) the decision needing a human,"
        say "(4) a recommendation with trade-offs. Then hand off."
        die_code
      fi
      say "preflight:"; preflight || { refuse; die_code; }
      say "full gates:"; CONFIG_ERROR=""; run_tier full; product; write_bundle
      if [ -n "${CONFIG_ERROR:-}" ]; then
        refuse
        say "REFUSING TO CERTIFY: ${CONFIG_ERROR}."
        say "Fix .claude/gates.json — a gate set that cannot be read is not a passing gate set."
        die_code
      fi
      if [ -n "$FAILED" ]; then
        refuse
        say "$FAILED"
        say "You cannot finish. Fix the CODE."
        say "  - Do not weaken, skip, or delete a test."
        say "  - Do not add '|| true', raise a timeout, or add a retry."
        say "  - Do not edit gates, hooks, or CI config."
        [ -n "$PRODUCT_MSG" ] && say "" && say "$PRODUCT_MSG"
        say "Attempt $((attempts+1))/${MAX_BLOCKS} before escalation is required."
        die_code
      fi
      if [ "$PRODUCT_STATUS" = "absent" ] && untouched_this_session; then
        rm -f "$STATE"
        say "product : no contract here, but this session has not changed this repo, so nothing"
        say "          in it is being claimed done. Stopping is allowed. Arm it with the setup skill."
        exit 0
      fi
      if [ "$PRODUCT_STATUS" != "held" ]; then
        refuse
        say "$PRODUCT_MSG"
        say "Engineering gates are green; the product is not established, so this is not done."
        say "Attempt $((attempts+1))/${MAX_BLOCKS} before escalation is required."
        die_code
      fi
      rm -f "$STATE" "$STALL"
      if [ "${SKIPPED_N:-0}" -gt 0 ]; then
        say "GATES GREEN for what ran — ${SKIPPED_N} gate(s) scoped out, unexecuted not green."
        say "   Those gates are unproven for this change. Run VERIFY_SCOPE=0 bin/verify done to execute every one."
        say "   evidence: .claude/evidence/latest.json"
      else
        say "ALL GATES GREEN — evidence: .claude/evidence/latest.json"
      fi
      say "DONE — $PRODUCT_MSG; engineering gates green. Screenshots: .claude/evidence/shots/" ;;
  fingerprint) fingerprint ;;
  product)   FAILED=""; CONFIG_ERROR=""; product; say "$PRODUCT_MSG"; [ "$PRODUCT_STATUS" = held ] || exit 1 ;;
  *) say "usage: verify {preflight|fast|full|done [--hook]|product|blast <symbol>|tests}"; exit 1 ;;
esac
