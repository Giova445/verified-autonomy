#!/usr/bin/env bash
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
ROOT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
CONFIG="$ROOT/.claude/gates.json"
REGISTRY="$ROOT/.claude/evidence/assumptions.jsonl"
USAGE="usage: verify {preflight|fast|full|done [--hook]|product|fingerprint}"

say() { printf '%s\n' "$*" >&2; }

preflight() {
  local bad=0 status
  if command -v codegraph >/dev/null 2>&1; then
    status="$(codegraph status "$ROOT" 2>&1)"
    if [ -n "$status" ] && ! printf '%s' "$status" | grep -qiE "not initialized|no such|not found"; then
      say "  graph   : ok"
    else
      say "  graph   : NOT INITIALIZED. Run 'codegraph init -i'; until then blast radius is grep precision."
    fi
  else
    say "  graph   : codegraph is not on PATH; blast radius is grep precision."
  fi
  if [ -f "$CONFIG" ]; then
    if python3 -m json.tool "$CONFIG" >/dev/null 2>&1; then say "  gates   : parseable"
    else say "  gates   : INVALID JSON in $CONFIG"; bad=1; fi
  fi
  if [ -f "$REGISTRY" ] && grep -q '"status"[[:space:]]*:[[:space:]]*"open"' "$REGISTRY" 2>/dev/null; then
    say "  assume  : OPEN assumptions remain. Resolve them by reading the code or asking; never infer."
    grep '"status"[[:space:]]*:[[:space:]]*"open"' "$REGISTRY" | head -5 | sed 's/^/            /' >&2
    bad=1
  else
    say "  assume  : clean"
  fi
  return $bad
}

find_state() {
  local p
  for p in "$HERE/../hooks/state.py" "$ROOT/.claude/hooks/state.py"; do
    [ -f "$p" ] && { printf '%s' "$p"; return 0; }
  done
  return 1
}

case "${1:-done}" in
  preflight) say "preflight:"; preflight || exit 1 ;;
  fast|full|done|product|fingerprint|--hook)
    STATE_PY="$(find_state)" || {
      case " $* " in
        *" --hook "*) printf '%s\n' '{"systemMessage":"NO VERDICT: hooks/state.py was not found beside the runner, so nothing was checked"}'; exit 0 ;;
      esac
      say "CANNOT RUN: hooks/state.py is neither beside bin/ nor in .claude/hooks/"; exit 1
    }
    VERIFY_ROOT="$ROOT" VERIFY_HOME="$HERE" exec python3 "$STATE_PY" verify "$@" ;;
  *) say "$USAGE"; exit 1 ;;
esac
